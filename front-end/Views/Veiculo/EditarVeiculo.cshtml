@model EsteticaPorDoSol.Models.Veiculo

@{
    ViewData["Title"] = "Editar Veículo";
}

<h2>Editar Veículo</h2>

@if (ViewBag.Mensagem != null)
{
    <div class="alert alert-danger">
        @ViewBag.Mensagem
    </div>
}

<form asp-action="EditarVeiculo" asp-controller="Veiculo" method="post">

    <input type="hidden" asp-for="idVeiculo" />

    <div class="mb-3">
        <label asp-for="dsPlaca" class="form-label">Placa</label>
        <input asp-for="dsPlaca" class="form-control" />
        <span asp-validation-for="dsPlaca" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="dsModelo" class="form-label">Modelo</label>
        <input asp-for="dsModelo" class="form-control" />
        <span asp-validation-for="dsModelo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="dsCor" class="form-label">Cor</label>
        <input asp-for="dsCor" class="form-control" />
        <span asp-validation-for="dsCor" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Cliente</label>

        <select asp-for="idCliente" class="form-select">
            <option value="">Selecione um cliente</option>

            @foreach (var cliente in ViewBag.Clientes)
            {
                @if (cliente.idCliente == Model.idCliente)
                {
                    <option value="@cliente.idCliente" selected>@cliente.dsNome</option>
                }
                else
                {
                    <option value="@cliente.idCliente">@cliente.dsNome</option>
                }
            }
        </select>

        <span asp-validation-for="idCliente" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Salvar Alterações
    </button>

    <a asp-action="ListarVeiculo" class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}