# Copie para .env e ajuste. O docker-compose le esse arquivo automaticamente.
# Sem .env, os valores padrao entre chaves no docker-compose.yml sao usados.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=DbEsteticaPorDoSol

# Porta do MySQL exposta no host (so em 127.0.0.1). Mude se ja houver um MySQL local.
MYSQL_PORT=3306

# Porta em que o site fica acessivel: http://localhost:8080
APP_PORT=8080
